# Copy to .env and replace every value before deployment.
# Development: docker-compose.yml chạy được không cần .env (dùng giá trị mặc định chỉ dành cho máy local).
# Production:  docker compose -f docker-compose.yml -f docker-compose.prod.yml ... (hoặc scripts/deploy.ps1 -Production)
#              BẮT BUỘC đặt mọi biến bên dưới; thiếu biến thì compose từ chối chạy. Không dùng lại các giá trị change-me-*.
#              Sinh secret: JWT_SECRET/INTERNAL_SERVICE_KEY >= 32 ký tự ngẫu nhiên, ví dụ: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-database
RABBITMQ_USER=erp_rabbit
RABBITMQ_PASSWORD=change-me-rabbitmq
JWT_SECRET=change-me-with-at-least-32-random-characters
INTERNAL_SERVICE_KEY=change-me-internal-service-key

# Generate each key with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
IDENTITY_APP_KEY=
CATALOG_APP_KEY=
SALES_APP_KEY=
EOFFICE_APP_KEY=
FINANCE_APP_KEY=

GROQ_API_KEY=

# ai-service: bật ETL đọc schema các service để dựng kho phân tích (chỉ cho demo, xem docs/deployment.md)
AI_WAREHOUSE_SYNC_ENABLED=false

# Grafana (docker compose --profile monitoring up -d), http://127.0.0.1:3000 user admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Cổng giao diện Mailpit trên máy (mặc định 8125)
MAILPIT_UI_PORT=8125
