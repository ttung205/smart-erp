# Copy to .env and replace every value before deployment.
# Development: docker-compose.yml chạy được không cần .env (dùng giá trị mặc định chỉ dành cho máy local).
# Production:  docker compose -f docker-compose.yml -f docker-compose.prod.yml ... (hoặc scripts/deploy.ps1 -Production)
#              BẮT BUỘC đặt mọi biến bên dưới; thiếu biến thì compose từ chối chạy. Không dùng lại các giá trị change-me-*.
#              Kiểm tra trước khi chạy: scripts/validate-prod-config.ps1
#              Sinh secret: openssl rand -hex 32 (JWT_SECRET/INTERNAL_SERVICE_KEY >= 32 ký tự, còn lại >= 16)

# ---- MySQL ----
# Root và erp_user chỉ được tạo ở lần khởi động đầu tiên của volume mysql_data: đổi sau đó phải đổi cả trong MySQL.
MYSQL_ROOT_PASSWORD=change-me-root
# erp_user: chỉ dùng cho test (erp_*_test) và công cụ dev; không service nào kết nối bằng tài khoản này
MYSQL_PASSWORD=change-me-database

# Mỗi service một tài khoản MySQL chỉ có quyền trên schema của mình (infrastructure/mysql/init/03-create-service-users.sh).
# Đổi mật khẩu trên volume đã có: scripts/apply-db-users.ps1
IDENTITY_DB_PASSWORD=change-me-identity-db
CATALOG_DB_PASSWORD=change-me-catalog-db
PURCHASE_DB_PASSWORD=change-me-purchase-db
INVENTORY_DB_PASSWORD=change-me-inventory-db
SALES_DB_PASSWORD=change-me-sales-db
EOFFICE_DB_PASSWORD=change-me-eoffice-db
FINANCE_DB_PASSWORD=change-me-finance-db
# ai-service: toàn quyền erp_analytics_db, chỉ SELECT trên các schema nguồn của ETL
ANALYTICS_DB_PASSWORD=change-me-analytics-db

# ---- RabbitMQ ----
# Cũng chỉ được tạo ở lần khởi động đầu tiên của volume rabbitmq_data
RABBITMQ_USER=erp_rabbit
RABBITMQ_PASSWORD=change-me-rabbitmq

# ---- Bảo mật giữa các service ----
# Khóa ký/kiểm tra JWT (HS256), mọi service dùng chung
JWT_SECRET=change-me-with-at-least-32-random-characters
# Header X-Internal-Service-Key khi service gọi nhau không kèm token người dùng
INTERNAL_SERVICE_KEY=change-me-internal-service-key

# ---- Laravel APP_KEY ----
# Generate each key with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
IDENTITY_APP_KEY=
CATALOG_APP_KEY=
SALES_APP_KEY=
EOFFICE_APP_KEY=
FINANCE_APP_KEY=

# ---- AI ----
GROQ_API_KEY=
# ai-service: bật ETL đọc schema các service để dựng kho phân tích (chỉ cho demo, xem docs/deployment.md)
AI_WAREHOUSE_SYNC_ENABLED=false

# ---- Giám sát ----
# Grafana (docker compose --profile monitoring up -d), http://127.0.0.1:3000 user admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Cổng giao diện Mailpit trên máy (mặc định 8125)
MAILPIT_UI_PORT=8125
