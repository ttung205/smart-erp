# Dependencies
node_modules/
vendor/

# Python: bytecode và môi trường ảo (áp dụng cho mọi thư mục, kể cả tools/)
__pycache__/
*.py[cod]
.venv/

# .NET Build artifacts
[Bb]in/
[Oo]bj/
.tmp/
.vs/
.idea/
*.user
*.suo

# Environment & Secret files
.env
.env.backup
.env.production
.env.*
!.env.example

# Secret/credential material & generated compose output (resolve mọi biến, có thể chứa secret)
compose-resolved.json
*.pem
*.key

# Bản sao lưu dữ liệu (chứa dữ liệu thật, không bao giờ commit)
backups/

# Local Databases
# File SQLite lạc chỗ do cấu hình DB sai (DB_DATABASE trỏ tên schema MySQL khi DB_CONNECTION=sqlite)
services/*/erp_*_db
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
**/inquiry-attachments/
**/chat-files/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# Skill cài bằng npx skills: bản gốc nằm ở .agents/skills, .claude/skills là liên kết do công cụ tạo
.claude/skills/
