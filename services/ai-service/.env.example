AI_SERVICE_PORT=8010
# Phải trùng JWT_SECRET của identity-service
JWT_SECRET=
# Lấy key miễn phí tại https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SYNC_INTERVAL_SECONDS=300

# MySQL: lịch sử hội thoại + kho phân tích (schema erp_analytics_db) và nguồn ETL (đọc chỉ-đọc các schema erp_*_db)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=erp_user
MYSQL_PASSWORD=erp_secret
ANALYTICS_DB_NAME=erp_analytics_db
