PORT=8006

# SMTP (Mailpit local: 127.0.0.1:1025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=sales@thanhtung.vn
MAIL_FROM_NAME="Smart ERP"

# Notification inbox & realtime
JWT_SECRET=smart_erp_super_secure_jwt_secret_key_2026
IDENTITY_SERVICE_URL=http://127.0.0.1:8001
# Tải tệp đính kèm email từ service sở hữu (X-Internal-Service-Key)
SALES_SERVICE_URL=http://127.0.0.1:8005
PURCHASE_SERVICE_URL=http://127.0.0.1:8003
RABBITMQ_URL=amqp://erp_rabbit:rabbit_secret@127.0.0.1:5672
# MongoDB (docker compose up -d mongo). directConnection vì replica set một node
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
NOTIFICATION_DB_NAME=erp_notification_db

# Khóa dùng chung khi các service gọi nhau (header X-Internal-Service-Key)
INTERNAL_SERVICE_KEY=smart_erp_internal_2026
